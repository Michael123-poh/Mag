# Copiez ce fichier en ".env" puis adaptez les valeurs. Le fichier .env ne doit JAMAIS être partagé ni publié.

PORT=3001
NODE_ENV=development

# Base de données MySQL
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=gaia

# Clé qui signe les sessions : au moins 32 caractères aléatoires (ex. node -e "console.log(require('crypto').randomBytes(48).toString('hex'))")
JWT_SECRET=

# Origine du site web autorisée à appeler l'API (laisser vide si le front passe par le proxy de Vite / le même domaine)
CORS_ORIGIN=

# En production derrière un proxy HTTPS (nginx…) : mettre 1
TRUST_PROXY=

# Cookie de session envoyé uniquement en HTTPS : true en production
COOKIE_SECURE=false

# Date « du jour » imposée pour la démonstration (les données fictives sont de octobre 2026).
# À SUPPRIMER (laisser vide) pour travailler avec la vraie date.
APP_TODAY=2026-10-27

# Lecture des machines sur le réseau (page Rapport) : SNMP en lecture seule
# Communauté de la machine (réglage d'usine : public ; si vous l'avez changée sur la machine, mettez la nouvelle ici)
SNMP_COMMUNITY=public
# Secondes entre deux lectures de la machine (5 à 3600)
MACHINES_POLL_SECONDS=20
# Un relevé n'est enregistré en base que si le compteur a changé, au plus toutes les X minutes
RELEVE_MIN_MINUTES=5
# Mettre « off » pour ne pas lire les machines (ex. travail hors du réseau de l'atelier)
MACHINES_POLL=on

